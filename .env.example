# Core
ENVIRONMENT=dev
SERVICE_NAME=latticeai-gateway
API_KEY_SECRET=change-me

# Database
DATABASE_URL=postgresql+asyncpg://lattice:lattice@postgres:5432/lattice

# Redis
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_RPM=60

# Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_BASE_URL=
REQUEST_TIMEOUT_S=30

# Auth
SESSION_SECRET=change-me
SESSION_COOKIE_NAME=lattice_session
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false
AUTO_MIGRATE=true
AUTO_MIGRATE_RETRIES=20
AUTO_MIGRATE_DELAY_SECONDS=2
AUTO_GENERATE_MIGRATIONS=true
ADMIN_EMAIL=admin@lattice.com
ADMIN_PASSWORD=admin@lattice
ADMIN_ORG_NAME=lattice-org
FALLBACK_ORDER=openai,groq,anthropic
FALLBACK_ENABLED_DEFAULT=true
OPENAI_DEFAULT_MODEL=gpt-4o-mini
GROQ_DEFAULT_MODEL=llama-3.1-8b-instant
ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
